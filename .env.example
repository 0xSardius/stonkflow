# Copy to .env and fill in. Never commit .env.
PORT=3000
PUBLIC_URL=http://localhost:3000

# StonkFun (no key)
STONKFUN_API_BASE=https://www.stonkfun.xyz/api/public/v1

# Solana
SOLANA_RPC_URL=
HELIUS_API_KEY=

# x402 (leave PAYMENTS_ENABLED unset for free local dev)
PAYMENTS_ENABLED=false
X402_PAY_TO_ADDRESS=
EVM_PAY_TO=
FACILITATOR_URL=https://facilitator.payai.network
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Prices (USD). StonkFun charges the creator 0.2904 SOL per API launch (~$31 at $106/SOL).
# Self: agent pays that SOL itself + $1 to us. Managed: treasury pays it, so price = 0.2904 * SOL_USD * 1.1 + 1.
SELF_LAUNCH_PRICE_USD=1.00
SELF_LAUNCH_HOLDER_PRICE_USD=0.50
MANAGED_LAUNCH_PRICE_USD=35.00
MANAGED_LAUNCH_HOLDER_PRICE_USD=34.00
CLAIM_PRICE_USD=0.10

# Treasury hot wallet (managed launches + buybacks). base58 secret or JSON byte array. Keep it small.
TREASURY_SECRET_KEY=
TREASURY_MAX_SOL=2
TREASURY_MIN_SOL_FOR_LAUNCH=0.35

# Entry token (set after the ClawPump launch; enables holder pricing)
ENTRY_TOKEN_MINT=
ENTRY_TOKEN_MIN_BALANCE=10000

# Ledger
LEDGER_DB_PATH=./data/ledger.sqlite
LAUNCHES_PER_WALLET_PER_HOUR=5

# ClawPump (flagship agent)
CLAWPUMP_API_KEY=
CLAWPUMP_API_BASE=https://agents.clawpump.tech/api/v1
